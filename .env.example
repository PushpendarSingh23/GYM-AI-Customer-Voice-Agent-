GROQ_API_KEY=

OPENAI_API_KEY=

# --- LangSmith tracing (optional) ---
# Flip to true and set LANGSMITH_API_KEY to watch the agent handoffs in the
# LangSmith trace tree. Left off by default so running without a LangSmith
# account doesn't spam 401s trying to send traces nowhere.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pipecat-langgraph-example
